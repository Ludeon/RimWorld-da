﻿<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: attended concert -->
  <AttendedConcert.stages.attended_concert.label>var til koncert</AttendedConcert.stages.attended_concert.label>
  <!-- EN: I enjoyed listening to that performance. -->
  <AttendedConcert.stages.attended_concert.description>Jeg nød at høre koncerten.</AttendedConcert.stages.attended_concert.description>
  
  <!-- EN: attended party -->
  <AttendedParty.stages.attended_party.label>var til fest</AttendedParty.stages.attended_party.label>
  <!-- EN: I had a good time at that party. -->
  <AttendedParty.stages.attended_party.description>Jeg havde det sjovt til festen.</AttendedParty.stages.attended_party.description>
  
  <!-- EN: attended wedding -->
  <AttendedWedding.stages.attended_wedding.label>var til bryllup</AttendedWedding.stages.attended_wedding.label>
  <!-- EN: It was great to see two people come together to build a future like that. -->
  <AttendedWedding.stages.attended_wedding.description>Det er dejligt at se to personer blive forenet og skabe en fremtid sammen.</AttendedWedding.stages.attended_wedding.description>
  
  <!-- EN: encouraging speech -->
  <EncouragingSpeech.stages.encouraging_speech.label>opmuntrende tale</EncouragingSpeech.stages.encouraging_speech.label>
  <!-- EN: That speech made me feel like we have a solid path forward. -->
  <EncouragingSpeech.stages.encouraging_speech.description>Den tale fik mig til at føle at vi bevæger os i den rigtige retning.</EncouragingSpeech.stages.encouraging_speech.description>
  
  <!-- EN: got married to {0} -->
  <GotMarried.stages.got_married_to.label>blev gift med {0}</GotMarried.stages.got_married_to.label>
  <!-- EN: I got married! It's so wonderful to be starting a new life together! -->
  <GotMarried.stages.got_married_to.description>Jeg blev gift! Det er så fantastisk at skulle starte et nyt liv sammen!</GotMarried.stages.got_married_to.description>
  
  <!-- EN: held concert -->
  <HeldConcert.stages.held_concert.label>holdte koncert</HeldConcert.stages.held_concert.label>
  <!-- EN: They loved me. They really loved me. -->
  <HeldConcert.stages.held_concert.description>De elskede mig. De elskede mig virkelig.</HeldConcert.stages.held_concert.description>
  
  <!-- EN: inspirational speech -->
  <InspirationalSpeech.stages.inspirational_speech.label>inspirerende tale</InspirationalSpeech.stages.inspirational_speech.label>
  <!-- EN: That speech was moving emotionally and intellectually. I am filled with purpose. -->
  <InspirationalSpeech.stages.inspirational_speech.description>Den tale påvirkede mig emotionelt og intellektuelt. Jeg føler at jeg har et formål.</InspirationalSpeech.stages.inspirational_speech.description>
  
  <!-- EN: terrible speech -->
  <TerribleSpeech.stages.terrible_speech.label>forfærdelig tale</TerribleSpeech.stages.terrible_speech.label>
  <!-- EN: That speech was atrocious. It made me realize how little hope we really have. -->
  <TerribleSpeech.stages.terrible_speech.description>Den tale var rædselsfuld. Det fik mig til at indse hvor lidt håb vi i virkeligheden har.</TerribleSpeech.stages.terrible_speech.description>
  
  <!-- EN: uninspiring speech -->
  <UninspiringSpeech.stages.uninspiring_speech.label>uinspirerende tale</UninspiringSpeech.stages.uninspiring_speech.label>
  <!-- EN: That speech was more awkward than inspiring. If that's who we're listening to, I'm worried. -->
  <UninspiringSpeech.stages.uninspiring_speech.description>Den tale var mere akavet end inspirerende. Hvis det er den person vi lytter til, er jeg bekymret.</UninspiringSpeech.stages.uninspiring_speech.description>
  
</LanguageData>